# Default expense sheet, loaded when the app opens.
# Copy this file to .env.local and set ONE of the following:
#
# 1) Google Sheet link (Share → General access → "Anyone with the link" → Viewer).
#    Copy the URL of the tab with your table; keeping "#gid=…" makes sure the right tab is read.
#    VITE_DEFAULT_SHEET=https://docs.google.com/spreadsheets/d/XXXXXXXX/edit#gid=0
#
# 2) An Excel/CSV file inside the project's public/ folder (e.g. public/expenses.xlsx):
#    VITE_DEFAULT_SHEET=expenses.xlsx
#
# 3) Any direct .xlsx/.csv URL that allows cross-origin downloads (CORS):
#    VITE_DEFAULT_SHEET=https://example.com/expenses.xlsx
#
# Changing this value takes effect on the next load, even for browsers that picked another
# source before. Restart `npm run dev` after editing env files.
VITE_DEFAULT_SHEET=
